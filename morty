--─────────────────────────── ГЛАВНЫЕ ЦИКЛЫ ─────────────────────────
bind(RunService.RenderStepped:Connect(function(dt)
    if not alive then return end

    for i = #rings, 1, -1 do
        local r = rings[i]
        if r.frame.Parent then
            r.frame.Rotation = (r.frame.Rotation + r.speed * dt) % 360
        else
            table.remove(rings, i)
        end
    end

    if scanOverlay.Visible then
        scanOverlay.BackgroundTransparency = CONFIG.SCAN_GLOW
            + math.sin(os.clock() * 2.2) * 0.07
    end
end))

local statusTimer = 0

bind(RunService.Heartbeat:Connect(function(dt)
    if not alive then return end

    -- ОРБИТА ДРОНОВ
    if droneOn and root and root.Parent then
        orbitTime += dt
        local n = math.max(#drones, 1)
        for i, d in ipairs(drones) do
            local phase = (i - 1) * (math.pi * 2 / n)
            local theta = orbitTime * CONFIG.ORBIT_SPEED + phase
            local x = math.cos(theta) * CONFIG.ORBIT_RADIUS
            local z = math.sin(theta) * CONFIG.ORBIT_RADIUS
            local y = CONFIG.ORBIT_HEIGHT + math.sin(orbitTime * 1.7 + phase * 2) * CONFIG.ORBIT_BOB
            local pos = root.Position + Vector3.new(x, y, z)
            local look = CFrame.lookAt(pos, Vector3.new(root.Position.X, pos.Y, root.Position.Z))
            local pivot = look * CFrame.Angles(0, math.sin(orbitTime * 1.5 + phase) * 0.4, 0)
            if d.rig.Parent then
                d.rig:PivotTo(pivot)
                for _, s in ipairs(d.spinners) do
                    s.part.CFrame = pivot * s.rel * CFrame.Angles(orbitTime * CONFIG.ROTOR_SPEED * s.dir + s.phase, 0, 0)
                end
            end
        end
    end

    -- ЩУПАЛЬЦА
    if tentOn and #tentacles > 0 then
        for _, t in ipairs(tentacles) do
            for si, m in ipairs(t.motors) do
                if m.Part1 and m.Part1.Parent then
                    m.DesiredAngle = t.baseRad[si]
                        + math.sin(os.clock() * 1.8 + t.phase + si * 0.5) * 0.1
                end
            end
        end
    end

    -- ПРИСОСКА
    if suckTarget then
        local myChar = suckTarget.char
        local tRoot = myChar and myChar.Parent and myChar:FindFirstChild("HumanoidRootPart")
        local tHum = suckTarget.hum
        if not (tRoot and tHum.Parent and tHum.Health > 0) then
            suckTarget = nil
            setButtonState(bSuck, false)
            if humanoid and humanoid.Parent then
                humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        elseif os.clock() - jumpFlag < 0.15 then
            suckTarget = nil
            setButtonState(bSuck, false)
            root.AssemblyLinearVelocity = root.CFrame.LookVector * 24 + Vector3.new(0, 14, 0)
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            showNotice("ПРИСОСКА: ОТПУЩЕНО", CONFIG.C_SUB)
        else
            humanoid:ChangeState(Enum.HumanoidStateType.Physics)
            local behind = tRoot.CFrame * CFrame.new(0, 0, CONFIG.SUCK_OFFSET)
            root.CFrame = CFrame.lookAt(behind.Position, behind.Position + tRoot.CFrame.LookVector)
            root.AssemblyLinearVelocity = tRoot.AssemblyLinearVelocity
        end
    end

    -- ЛАЗАНИЕ
    if tentOn and root and humanoid and humanoid.Health > 0 and root.Parent
        and not flinging and not suckTarget then

        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {char}

        if not climbing then
            local fwd = workspace:Raycast(root.Position, root.CFrame.LookVector * 2.9, params)
            if fwd and math.abs(fwd.Normal.Y) < 0.98 and os.clock() > vaultUntil then
                climbing = true
                onCeiling = fwd.Normal.Y > 0.5
                wallNormal = fwd.Normal
                wallLostSince = nil
            end
        else
            local dir = -wallNormal
            local hit2 = workspace:Raycast(root.Position, dir * 3.4, params)
            if not hit2 then
                local rightV = Vector3.new(-wallNormal.Z, 0, wallNormal.X)
                rightV = rightV.Magnitude > 0.01 and rightV.Unit or Vector3.xAxis
                local probes = {
                    (dir + Vector3.new(0, -0.55, 0)).Unit,
                    (dir + Vector3.new(0, 0.55, 0)).Unit,
                    (dir + rightV * 0.6).Unit,
                    (dir - rightV * 0.6).Unit,
                }
                for _, pd in ipairs(probes) do
                    hit2 = workspace:Raycast(root.Position, pd * 3.6, params)
                    if hit2 then break end
                end
            end

            if os.clock() - jumpFlag < 0.15 then
                climbing = false
                local n = wallNormal
                wallNormal = nil
                wallLostSince = nil
                if onCeiling then
                    root.AssemblyLinearVelocity = -n * 8
                else
                    root.AssemblyLinearVelocity = dir * CONFIG.LEAP_POWER + Vector3.new(0, 18, 0)
                end
                vaultUntil = os.clock() + 0.4
                humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            elseif not hit2 or math.abs(hit2.Normal.Y) > 0.98 then
                if not wallLostSince then
                    wallLostSince = os.clock()
                    climbVel = root.AssemblyLinearVelocity.Y
                end
                humanoid:ChangeState(Enum.HumanoidStateType.Physics)
                if onCeiling then
                    climbing = false
                    wallNormal = nil
                    wallLostSince = nil
                    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                else
                    root.AssemblyLinearVelocity = dir * 6 + Vector3.new(0, math.max(climbVel * 0.8, 12), 0)
                    if os.clock() - wallLostSince > CONFIG.WALL_LOST_GRACE then
                        climbing = false
                        wallNormal = nil
                        wallLostSince = nil
                        root.AssemblyLinearVelocity = root.CFrame.LookVector * 16 + Vector3.new(0, CONFIG.VAULT_BOOST, 0)
                        vaultUntil = os.clock() + 0.5
                        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                    end
                end
            else
                wallLostSince = nil
                humanoid:ChangeState(Enum.HumanoidStateType.Physics)
                local normal = hit2.Normal
                onCeiling = normal.Y < -0.5
                wallNormal = normal
                local yaw = math.atan2(normal.X, normal.Z)
                root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)

                local move = humanoid.MoveDirection
                local rightV = Vector3.new(-normal.Z, 0, normal.X)
                rightV = rightV.Magnitude > 0.01 and rightV.Unit or Vector3.xAxis

                if onCeiling then
                    local flat = Vector3.new(move.X, 0, move.Z)
                    root.AssemblyLinearVelocity = normal * 3 + flat * (CONFIG.CLIMB_SPEED * 0.9)
                    climbVel = 0
                else
                    local intoWall = -move:Dot(normal)
                    local vert = intoWall * CONFIG.CLIMB_SPEED
                    local side = move:Dot(rightV) * CONFIG.CLIMB_SIDE
                    climbVel = vert
                    root.AssemblyLinearVelocity = normal * 2 + Vector3.new(0, vert, 0) + rightV * side
                end
            end
        end
    elseif climbing then
        climbing = false
        wallNormal = nil
        wallLostSince = nil
        if humanoid and humanoid.Parent then
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end

    statusTimer = statusTimer + dt
    if suckTarget then
        statusLabel.Text = "ПРИСОСКА // ПРОБЕЛ — ОТПУСТИТЬСЯ"
        statusLabel.TextColor3 = CONFIG.C_CYAN
    elseif climbing then
        statusLabel.Text = onCeiling and "ПОТОЛОК // WASD — ПОЛЗАТЬ, ПРОБЕЛ — УПАСТЬ"
            or "ЩУПАЛЬЦА // W↑ S↓ A/D←→ ПРОБЕЛ — ПРЫЖОК"
        statusLabel.TextColor3 = CONFIG.C_CYAN
    elseif statusTimer >= 0.25 and not flinging then
        statusTimer = 0
        local t, dist = getNearestTarget(60)
        if t then
            local plr = Players:GetPlayerFromCharacter(t)
            statusLabel.Text = ("ЦЕЛЬ: %s · %.0f м"):format(plr and plr.Name or "?", dist)
            statusLabel.TextColor3 = CONFIG.C_GOLD
        else
            statusLabel.Text = "ЦЕЛЬ: НЕ НАЙДЕНА"
            statusLabel.TextColor3 = CONFIG.C_SUB
        end
    end
end))

