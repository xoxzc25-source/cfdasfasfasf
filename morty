local cachedAsset

local function detachMesh()
    if meshAsset then meshAsset:Destroy() meshAsset = nil end
end

local function loadMeshAsset()
    if cachedAsset then return cachedAsset:Clone() end
    local stored = ReplicatedStorage:FindFirstChild("EM_Headband")
    if stored then cachedAsset = stored return stored:Clone() end
    local ok, result = pcall(function() return game:GetObjects(CONFIG.MESH_ID) end)
    if ok and type(result) == "table" then
        for _, obj in ipairs(result) do
            if obj:IsA("Accoutrement") or obj:IsA("Model") or obj:IsA("BasePart") then
                cachedAsset = obj
                return cachedAsset:Clone()
            end
        end
    end
    warn("[EvilMorty] Повязка не загрузилась: ", result)
    return nil
end

local function attachMesh()
    detachMesh()
    if not (char and head and head.Parent) then return false end

    local asset = loadMeshAsset()
    if not asset then return false end
    asset.Name = "EM_Headband_Local"

    for _, obj in ipairs(asset:GetDescendants()) do
        if obj:IsA("BaseScript") or obj:IsA("Sound")
        or obj:IsA("Weld") or obj:IsA("WeldConstraint") then
            obj:Destroy()
        end
    end

    local pivotPart
    if asset:IsA("BasePart") then
        pivotPart = asset
    elseif asset:IsA("Accoutrement") then
        pivotPart = asset:FindFirstChild("Handle") or asset:FindFirstChildWhichIsA("BasePart", true)
    else
        pivotPart = asset.PrimaryPart or asset:FindFirstChildWhichIsA("BasePart", true)
    end
    if not pivotPart then asset:Destroy() return false end

    local parts = {}
    if asset:IsA("BasePart") then parts[1] = asset else
        for _, p in ipairs(asset:GetDescendants()) do
            if p:IsA("BasePart") then table.insert(parts, p) end
        end
    end

    local function sat(c)
        local _, s, v = c:ToHSV()
        return s >= 0.4 and v >= 0.3
    end

    for _, p in ipairs(parts) do
        p.Anchored   = false
        p.Massless   = true
        p.CanCollide = false
        p.CanQuery   = false
        p.CanTouch   = false

        local sm = p:FindFirstChildOfClass("SpecialMesh")
        local vcColor = sm and Color3.new(sm.VertexColor.X, sm.VertexColor.Y, sm.VertexColor.Z) or nil

        if CONFIG.MESH_DEBUG then
            print(("[EvilMorty] '%s' class=%s size=%s color=%s vc=%s tex=%s"):format(
                p.Name, p.ClassName, tostring(p.Size), tostring(p.Color),
                sm and tostring(sm.VertexColor) or "—",
                sm and tostring(sm.TextureId ~= "") or (p:IsA("MeshPart") and tostring(p.TextureID ~= "") or "—")))
        end

        if table.find(CONFIG.MESH_KEEP, p.Name) then
            continue
        end

        local forceBlack = table.find(CONFIG.MESH_FORCE_BLACK, p.Name) ~= nil
        local colorful = sat(p.Color) or (vcColor and sat(vcColor))

        if forceBlack or not colorful then
            if p:IsA("MeshPart") then p.TextureID = "" end
            if sm then sm.TextureId = "" end
            if sm then sm.VertexColor = Vector3.zero end
            p.Color = CONFIG.MESH_COLOR
            p.Material = Enum.Material.SmoothPlastic
            p.Reflectance = 0
        end
    end

    for _, obj in ipairs(asset:GetDescendants()) do
        if obj:IsA("SurfaceAppearance") or obj:IsA("Decal") then obj:Destroy() end
    end

    for _, p in ipairs(parts) do
        if p ~= pivotPart then
            local wc = Instance.new("WeldConstraint")
            wc.Part0 = pivotPart
            wc.Part1 = p
            wc.Parent = p
        end
    end

    local weld = Instance.new("Weld")
    weld.Part0 = head
    weld.Part1 = pivotPart
    weld.C0 = MESH_OFFSET
    weld.Parent = pivotPart

    meshAsset = asset
    asset.Parent = char
    return true
end

