    humanoid = c:WaitForChild("Humanoid")
    torso    = c:WaitForChild("Torso") -- R6
    orbitTime = 0
    meshAsset = nil
    flinging = false
    climbing = false
    onCeiling = false
    suckTarget = nil
    markedTarget = nil
    wallNormal = nil
    OldPos = nil

    clearDrones()
    clearTentacles()
    stopScan()
    attachMesh()
    if droneOn then createDrones() end
    if tentOn then createTentacles() end

    humanoid.Died:Connect(function()
        clearDrones()
        clearTentacles()
        climbing = false
        suckTarget = nil
        wallNormal = nil
        stopScan()
    end)
end

