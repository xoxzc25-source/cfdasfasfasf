                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0.1),
                    NumberSequenceKeypoint.new(1, 1),
                }),
                LightEmission = 1, FaceCamera = true,
            }, half)

            -- искры с половины
            create("ParticleEmitter", {
                Texture = "rbxasset://textures/particles/sparkles_main.dds",
                Color = ColorSequence.new(CONFIG.C_GOLD),
                LightEmission = 1,
                Size = NumberSequence.new(0.2),
                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0.2),
                    NumberSequenceKeypoint.new(1, 1),
                }),
                Lifetime = NumberRange.new(0.3, 0.7),
                Rate = 30, Speed = NumberRange.new(2, 6),
                SpreadAngle = Vector2.new(180, 180),
            }, half)

            TweenService:Create(half, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                CFrame = half.CFrame * CFrame.new(side * 1.6, -2.2, 0) * CFrame.Angles(0, 0, math.rad(side * 70)),
                Transparency = 1,
            }):Play()
            Debris:AddItem(half, 1)
            Debris:AddItem(ha0, 1)
            Debris:AddItem(ha1, 1)
        end

        -- цель улетает за карту (полный насос FLING_TIME)
        task.spawn(function()
            skidFling(targetChar)
            flinging = false
            swordBusy = false
        end)
        local plr = Players:GetPlayerFromCharacter(targetChar)
        showNotice("РАЗРЕЗ // " .. (plr and plr.DisplayName or targetChar.Name), CONFIG.C_GOLD)
    end)

    tool.Parent = backpack
    showNotice("МЕЧ МОРТИ // В ИНВЕНТАРЕ (хотбар)", CONFIG.C_GOLD)
end

--─────────────────────────── ПОЛНОЕ УДАЛЕНИЕ ВСЕГО ──────────────────
local function killEverything()
    if not alive then return end
    alive = false

    isOpen = false
    flinging = false
    droneOn = false
    tentOn = false
    autoScanOn = false
    swordBusy = false
    climbing = false
    onCeiling = false
    wallNormal = nil
    wallLostSince = nil
    suckTarget = nil
    markedTarget = nil
    markedPlayer = nil
    OldPos = nil

    -- мир: скан, дроны, щупальца
    stopScan()
    clearDrones()
    clearTentacles()

    -- вернуть персонажа и камеру в норму
    pcall(function()
        if humanoid and humanoid.Parent then
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            Camera.CameraSubject = humanoid
        end
    end)
    stopAllVelocity()

    -- забрать меч
    pcall(function()
        local bp = LocalPlayer:FindFirstChild("Backpack")
        local t1 = bp and bp:FindFirstChild("Меч Морти")
        if t1 then t1:Destroy() end
        if char then
            local t2 = char:FindFirstChild("Меч Морти")
            if t2 then t2:Destroy() end
        end
    end)

    -- повязка (можно оставить: REMOVE_BAND_ON_CLOSE = false)
    if CONFIG.REMOVE_BAND_ON_CLOSE then
        detachMesh()
    end

    -- убить все соединения и бесконечные циклы
    pcall(function() toggleStrokeTween:Cancel() end)
    for _, c in ipairs(conns) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(conns)

    -- само меню
    gui:Destroy()
    print("[EvilMorty] Скрипт полностью удалён. Вернётся после перезахода.")
end

