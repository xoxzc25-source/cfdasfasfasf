local function createTentacles()
    clearTentacles()
    if not (char and root and torso and torso.Parent) then return end

    for i = 1, CONFIG.TENT_COUNT do
        local slot = TENT_SLOTS[((i - 1) % #TENT_SLOTS) + 1]
        local totalArc = TENT_ARC[((i - 1) % #TENT_ARC) + 1]
        local rig = Instance.new("Model")
        rig.Name = "EM_Tentacle_" .. i

        local motors = {}
        local baseRad = {}

        local prevPart = torso
        local jointC0 = CFrame.new(slot.x, slot.y, 0.55)

        for s = 1, CONFIG.TENT_SEGS do
            local w = 0.36 * (1 - (s - 1) / CONFIG.TENT_SEGS * 0.55)
            local seg = create("Part", {
                Name = "Seg" .. s,
                Size = Vector3.new(w, 0.42, w),
                Material = (s % 3 == 0) and Enum.Material.Neon or Enum.Material.Metal,
                Color = (s % 3 == 0) and CONFIG.C_CYAN
                    or ((s % 2 == 0) and Color3.fromRGB(52, 56, 64) or Color3.fromRGB(36, 39, 45)),
                CanCollide = false, CanQuery = false, CanTouch = false,
                Massless = true,
            }, rig)

            local m = Instance.new("Motor6D")
            m.Part0 = prevPart
            m.Part1 = seg
            if s == 1 then
                m.C0 = jointC0
                m.C1 = CFrame.new(0, -0.21, 0)
            else
                m.C0 = CFrame.new(0, 0.21, 0)
                m.C1 = CFrame.new(0, -0.21, 0)
            end
            m.MaxVelocity = 100
            m.Parent = prevPart
            table.insert(motors, m)

            local share = totalArc / CONFIG.TENT_SEGS * (0.8 + s * 0.05)
            table.insert(baseRad, math.rad(share))

            prevPart = seg
        end

        local last = rig:FindFirstChild("Seg" .. CONFIG.TENT_SEGS)
        if last then
            local core = create("Part", {
                Shape = Enum.PartType.Ball, Size = Vector3.new(0.4, 0.4, 0.4),
                Material = Enum.Material.Neon, Color = CONFIG.C_CYAN,
                CanCollide = false, CanQuery = false, CanTouch = false, Massless = true,
            }, rig)
            local mc = Instance.new("Motor6D")
            mc.Part0 = last
            mc.Part1 = core
            mc.C0 = CFrame.new(0, 0.21, 0)
            mc.C1 = CFrame.new(0, 0, 0)
            mc.MaxVelocity = 100
            mc.Parent = last
            table.insert(motors, mc)
            table.insert(baseRad, math.rad(totalArc / CONFIG.TENT_SEGS))
            for k = 1, 4 do
                local claw = create("Part", {
                    Size = Vector3.new(0.72, 0.08, 0.2),
                    Material = Enum.Material.Metal, Color = CONFIG.C_GOLD_D,
                    CanCollide = false, CanQuery = false, CanTouch = false, Massless = true,
                }, rig)
                local mw = Instance.new("Weld")
                mw.Part0 = core
                mw.Part1 = claw
                mw.C0 = CFrame.Angles(0, math.rad(k * 90 + 45), 0) * CFrame.new(0, 0, 0.5)
                mw.Parent = claw
            end
            create("PointLight", {Color = CONFIG.C_CYAN, Range = 8, Brightness = 2}, core)
        end

        rig.Parent = char
        tentacles[i] = {rig = rig, motors = motors, baseRad = baseRad, phase = i * 1.05}
    end
end

local function getNearestTarget(range)
    range = range or 60
    if not (root and root.Parent) then return nil end
    local bestChar, bestDist = nil, range
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist < bestDist then
                    bestChar, bestDist = plr.Character, dist
                end
            end
        end
    end
    return bestChar, bestDist
end

