local function createDrone(i)
    local rig = Instance.new("Model")
    rig.Name = "EM_Drone_" .. i
    local HARD = {Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false}
    local spinners = {}

    local body = create("Part", merge(HARD, {
        Name = "Body", Size = Vector3.new(0.5, 0.3, 0.75),
        Material = Enum.Material.Metal, Color = Color3.fromRGB(24, 22, 14),
        CFrame = CFrame.new(),
    }), rig)
    rig.PrimaryPart = body
    body:SetAttribute("OT", 0)

    create("Part", merge(HARD, {
        Name = "Plate", Size = Vector3.new(0.36, 0.06, 0.52),
        Material = Enum.Material.Metal, Color = CONFIG.C_GOLD_D,
        CFrame = CFrame.new(0, 0.18, 0),
    }), rig):SetAttribute("OT", 0)

    for _, x in ipairs({-0.12, 0.12}) do
        create("Part", merge(HARD, {
            Name = "Eye", Size = Vector3.new(0.16, 0.05, 0.02),
            Material = Enum.Material.Neon, Color = CONFIG.C_CYAN,
            CFrame = CFrame.new(x, 0.05, -0.38),
        }), rig):SetAttribute("OT", 0)
    end

    for _, dims in ipairs({{Size = Vector3.new(1.8, 0.05, 0.08)}, {Size = Vector3.new(0.08, 0.05, 1.8)}}) do
        create("Part", merge(HARD, {
            Name = "Arm", Size = dims.Size,
            Material = Enum.Material.Metal, Color = Color3.fromRGB(30, 27, 16),
            CFrame = CFrame.new(0, 0.1, 0),
        }), rig):SetAttribute("OT", 0)
    end

    for idx, pos in ipairs(ROTOR_POS) do
        local dir = (idx % 2 == 0) and -1 or 1
        create("Part", merge(HARD, {
            Name = "Hub", Shape = Enum.PartType.Ball, Size = Vector3.new(0.1, 0.1, 0.1),
            Material = Enum.Material.Neon, Color = CONFIG.C_CYAN,
            CFrame = CFrame.new(pos + Vector3.new(0, 0.04, 0)),
        }), rig):SetAttribute("OT", 0)

        local rotorBase = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))

        local disc = create("Part", merge(HARD, {
            Name = "Disc", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.02, 0.82, 0.82),
            Material = Enum.Material.Neon, Color = CONFIG.C_CYAN,
        }), rig)
        disc:SetAttribute("OT", 0.75)
        table.insert(spinners, {part = disc, rel = rotorBase, dir = dir, phase = 0})

        for b = 0, 2 do
            local blade = create("Part", merge(HARD, {
                Name = "Blade", Size = Vector3.new(0.03, 0.76, 0.06),
                Material = Enum.Material.Metal, Color = CONFIG.C_GOLD_D,
            }), rig)
            blade:SetAttribute("OT", 0)
            table.insert(spinners, {part = blade, rel = rotorBase, dir = dir, phase = b * (math.pi * 2 / 3)})
        end
    end

    create("PointLight", {Color = CONFIG.C_CYAN, Range = 7, Brightness = 1.3}, body)
    create("ParticleEmitter", {
        Texture = "rbxasset://textures/particles/sparkles_main.dds",
        Color = ColorSequence.new(CONFIG.C_CYAN, CONFIG.C_GOLD),
        LightEmission = 1, Size = NumberSequence.new(0.15),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.2),
            NumberSequenceKeypoint.new(1, 1),
        }),
        Lifetime = NumberRange.new(0.3, 0.6),
        Rate = 15, Speed = NumberRange.new(0.4, 1.2),
        SpreadAngle = Vector2.new(180, 180),
    }, body)

    local a0 = create("Attachment", {Position = Vector3.new(0, 0.18, 0)}, body)
    local a1 = create("Attachment", {Position = Vector3.new(0, -0.18, 0)}, body)
    create("Trail", {
        Attachment0 = a0, Attachment1 = a1, Lifetime = 0.25,
        Color = ColorSequence.new(CONFIG.C_CYAN, CONFIG.C_GOLD),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.35),
            NumberSequenceKeypoint.new(1, 1),
        }),
        LightEmission = 1, FaceCamera = true,
    }, body)

    rig.Parent = char
    return {rig = rig, spinners = spinners}
end

