local function hpColor(r)
    if r > 0.6 then return CONFIG.C_GOLD
    elseif r > 0.3 then return CONFIG.C_ORANGE
    else return CONFIG.C_RED end
end

local function triOutline(container, verts, thickness, color, transparency)
    for i = 1, 3 do
        local a, b = verts[i], verts[i % 3 + 1]
        local mid = (a + b) / 2
        local d = b - a
        local len = d.Magnitude
        create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(mid.X, mid.Y),
            Size = UDim2.fromScale(len * 1.06, thickness),
            Rotation = math.deg(math.atan2(d.Y, d.X)),
            BackgroundColor3 = color,
            BackgroundTransparency = transparency or 0,
            BorderSizePixel = 0,
        }, container)
    end
end

local function makeTriangleLogo(parent)
    local container = create("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1, BorderSizePixel = 0,
    }, parent)
    local A, B, C = Vector2.new(0.5, 0.04), Vector2.new(0.96, 0.93), Vector2.new(0.04, 0.93)
    triOutline(container, {A, B, C}, 0.045, CONFIG.C_RED)
    local cx, cy, k = 0.5, 0.62, 0.66
    local function shrink(p)
        return Vector2.new(cx + (p.X - cx) * k, cy + (p.Y - cy) * k)
    end
    triOutline(container, {shrink(A), shrink(B), shrink(C)}, 0.018, Color3.fromRGB(255, 238, 180), 0.05)
    create("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.56), Size = UDim2.fromScale(0.4, 0.4),
        BackgroundTransparency = 1, Font = Enum.Font.SourceSansBold,
        Text = "🧠", TextScaled = true,
        TextColor3 = Color3.fromRGB(255, 238, 180),
    }, container)
    return container
end

