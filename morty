local function create(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props) do inst[k] = v end
    inst.Parent = parent
    return inst
end

local function merge(base, extra)
    local t = table.clone(base)
    for k, v in pairs(extra) do t[k] = v end
    return t
end

