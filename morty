local function flyAndExplode(rig, tRoot, onDone)
    local start = rig:GetPivot().Position
    local t0 = os.clock()
    local DUR = 0.55
    local spin = 0
    local finished = false
    local function finish(exploded)
        if finished then return end
        finished = true
        if exploded and tRoot.Parent then
            explodeAt(tRoot.Position)
        end
        if rig.Parent then rig:Destroy() end
        if onDone then onDone() end
    end
    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        if not alive or not rig.Parent then
            conn:Disconnect()
            finish(false)
            return
        end
        if not tRoot.Parent then
            conn:Disconnect()
            finish(false)
            return
        end
        local a = (os.clock() - t0) / DUR
        local p2 = tRoot.Position
        if a >= 1 then
            conn:Disconnect()
            finish(true)
        else
            local p1 = (start + p2) / 2 + Vector3.new(0, 5, 0)
            local q = (1 - a) * (1 - a) * start + 2 * (1 - a) * a * p1 + a * a * p2
            spin += dt * 22
            rig:PivotTo(CFrame.lookAt(q, p2) * CFrame.Angles(spin, spin, 0))
        end
    end)
end

