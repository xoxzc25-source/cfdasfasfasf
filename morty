local function getAimedTarget(range)
    if not char then return nil end
    local camPos = Camera.CFrame.Position
    local vp = Camera.ViewportSize
    local center = vp / 2
    local maxR = math.min(vp.X, vp.Y) * 0.4

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}

    local best, bestScore = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local h = plr.Character:FindFirstChild("Head")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if h and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(h.Position)
                if onScreen then
                    local dist = (h.Position - camPos).Magnitude
                    if dist > 1 and dist <= range then
                        local screenDist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if screenDist <= maxR and screenDist < bestScore then
                            local hit = workspace:Raycast(camPos, (h.Position - camPos).Unit * dist, params)
                            if hit and hit.Instance:IsDescendantOf(plr.Character) then
                                best, bestScore = plr.Character, screenDist
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

